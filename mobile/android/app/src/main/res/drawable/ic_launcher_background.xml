<?xml version="1.0" encoding="utf-8"?>
<!--
  自适应图标的背景层：白 → 极浅冷灰的竖向渐变。
  纯白在一堆彩色图标里发飘，一点点渐变就有体积感，又不动品牌色。
  ⚠️ 必须铺满 108×108 整块 —— 启动器会按自己的形状去裁，
     背景留白等于把裁切边缘暴露成透明。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:fillColor">
            <gradient android:type="linear"
                android:startX="54" android:startY="0"
                android:endX="54" android:endY="108">
                <item android:offset="0" android:color="#FFFFFFFF" />
                <item android:offset="1" android:color="#FFEDF1F6" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
