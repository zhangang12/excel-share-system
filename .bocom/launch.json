{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend-uvicorn",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "app.main:app",
        "--reload",
        "--port",
        "8000"
      ],
      "cwd": "backend",
      "port": 8000,
      "url": "http://127.0.0.1:8000",
      "note": "入口 app.main:app 按你的实际变量名核一眼(FastAPI 里那个 app = FastAPI())"
    },
    {
      "name": "desktop",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start"
      ],
      "cwd": "desktop",
      "port": 3000,
      "url": "http://127.0.0.1:3000"
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "cwd": "frontend",
      "port": 5173,
      "url": "http://127.0.0.1:5173"
    }
  ]
}